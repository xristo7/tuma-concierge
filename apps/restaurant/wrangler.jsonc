{
  "name": "tuma-restaurant",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // No custom_domain route yet — restaurant.tumaffe.online DNS isn't set
  // up. Live at the workers.dev URL until that's added; add a routes
  // entry here (matching rider/admin's pattern) once it is.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    // Works around a known opennextjs-cloudflare bug (pnpm's symlinked
    // node_modules breaks the middleware-manifest.json inlining, causing an
    // unsupported dynamic require() at runtime — opennextjs/opennextjs-cloudflare#1232).
    // Safe here: neither app uses Next.js middleware.
    "NEXT_PRIVATE_MINIMAL_MODE": "1"
  }
}
