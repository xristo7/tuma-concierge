{
  "name": "tuma-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tuma-api",
      "database_id": "26926e12-d2f4-4b40-8b1b-019f6c169e10"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RIDER_DOCS",
      "bucket_name": "tuma"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CALL_ROOM",
        "class_name": "CallRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CallRoom"]
    }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "CORS_ORIGINS": "https://tuma-customer.doxalight-inc.workers.dev,https://tuma-rider.doxalight-inc.workers.dev,http://localhost:3000,http://localhost:3001",
    "MOMO_TARGET_ENV": "sandbox",
    "MOMO_BASE_URL": "https://sandbox.momodeveloper.mtn.com",
    "MOMO_CURRENCY": "UGX"
  }
}
